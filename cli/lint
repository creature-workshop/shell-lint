#!/usr/bin/env bash
set -euo pipefail

SHELL_LINT_DIR="${SHELL_LINT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export SHELL_LINT_DIR
export SHELLOPS_DIR="${SHELLOPS_DIR:-$SHELL_LINT_DIR/shell/.ops}"
export SHELL_SCAN_DIR="${SHELL_SCAN_DIR:-$SHELL_LINT_DIR/shell/.scan}"
. "$SHELLOPS_DIR/.envrc"

import \
  "$SHELLOPS_DIR/lib/args/api.sh" \
  "$SHELL_LINT_DIR/shell/lint/run.sh"

USAGE="$(cat <<HELP
Runs the house-style lint checks over a repository's shell, awk, jq, markdown
and yaml files.

Every check runs over the files it reads. A file is shell by its .sh or .bats
suffix or its shebang, awk, jq, markdown or yaml by suffix. Files under a test
directory (test/ and tests/, or the names lint.json gives under "tests") go
only to the checks that read tests. Every finding is printed before the
verdict, as "<file>:<line>: <message>", followed by the check's rule and how
to satisfy it. Text inside heredocs is never checked.

Usage: lint [-h,--help] [--list] [--explain <name>] [--check <name>]... [--added-only] [files...]

With no files, checks every file git tracks under the project, minus the
directories \$PROJ/lint.json excludes. With files (as lefthook passes staged
files), checks only those, tracked or not; a file no check reads is skipped.

\$PROJ/lint.json is optional. It sets the indent width, the test directory
names, the directories no check looks in, under "checks" the directories the
repository keeps its own checks under, under "added_only" the checks that
run only with --added-only (use that for a check the code does not pass yet,
so new lines are held to it while a full sweep leaves it out), and under
"templates" which yaml files are CI component templates and what the template
checks need to know about the catalog.

Flags:
  --list          Print every check: its name, languages, scopes and rule.
  --explain <name>
                  Print the named check's rule and how to satisfy it, for a
                  reader with one of its findings in hand.
  --check <name>  Run only the named check; repeat to run several.
  --added-only    Pre-commit mode: report only lines the staged diff added,
                  and run the checks lint.json holds to new lines too.
  -h, --help      Show this help text
HELP
)"

__cli__NL="
"

main() {
  parse_args "$@"
  CONFIG="$(lint__config_load)" || exit 1
  lint__load_project_checks "$CONFIG" || exit 1

  if @is_true "$LIST"; then
    lint__describe_checks
    exit 0
  fi

  reject_unknown_checks

  if @defined "$EXPLAIN"; then
    lint__explain_check "$EXPLAIN"
    exit 0
  fi

  if @defined "$INPUT_FILES"; then
    __main__listing="$(lint__select_named "$CONFIG" "$INPUT_FILES")"
  else
    __main__listing="$(lint__discover_tracked "$CONFIG")"
  fi

  @defined "$__main__listing" || exit 0

  __main__opts="$(@obj \
    '.added_only' "$ADDED_ONLY" \
    '.config' "$CONFIG"
  )"
  lint__run "$__main__opts" "$SELECTED" "$__main__listing" || exit 1
}

: <<'FUN'
Collects the flags, and the file arguments into the INPUT_FILES
newline-separated global (POSIX sh functions cannot write the caller's argv).
A path carrying a newline or tab cannot travel that way, so one is refused
outright rather than mis-filed or silently skipped.
FUN
parse_args() {
  INPUT_FILES=""
  SELECTED="$(@arr)"
  ADDED_ONLY="$(@false)"
  LIST="$(@false)"
  EXPLAIN=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      -h|--help)
        log "$USAGE"
        exit 0
        ;;
      --list)
        LIST="$(@true)"
        ;;
      --check)
        args__require_value "$@" || exit 1
        SELECTED="$(@push "$SELECTED" "$2")"
        shift
        ;;
      --explain)
        args__require_value "$@" || exit 1
        EXPLAIN="$2"
        SELECTED="$(@push "$SELECTED" "$2")"
        shift
        ;;
      --added-only)
        ADDED_ONLY="$(@true)"
        ;;
      -*)
        error "Unknown option: $1"
        exit 1
        ;;
      *)
        require_plain_path "$1"
        INPUT_FILES="$INPUT_FILES$1$__cli__NL"
        ;;
    esac
    shift
  done
}

: <<'FUN'
Exits when <path> carries a newline or a tab, which the line-oriented listing
cannot hold.
FUN
require_plain_path() {
  @is_true "$(lint__is_plain_path "$1")" && return 0

  error "Cannot lint a path containing a newline or tab; rename it first."
  exit 1
}

: <<'FUN'
Exits with the known names when any --check name has no registered check.
FUN
reject_unknown_checks() {
  __reject_unknown_checks__unknown="$(lint__unknown_checks "$SELECTED")"
  if [ "$(@len "$__reject_unknown_checks__unknown")" -eq 0 ]; then
    return 0
  fi

  __reject_unknown_checks__names="$(@join "$__reject_unknown_checks__unknown" ', ')"
  __reject_unknown_checks__known="$(@join "$(lint__registry_names)" ' ')"
  error "Unknown --check name: $__reject_unknown_checks__names"
  hint "Expected one of: $__reject_unknown_checks__known"
  exit 1
}

# Run only when executed directly; sourcing (e.g. from bats) skips main.
case "$0" in
  */lint|lint) main "$@" ;;
esac
